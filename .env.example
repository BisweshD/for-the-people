# For The People configuration. Copy to .env for local use. Keep real values private.

# Postgres (Neon) for preview and production. Without it, the app loads the bundled snapshot into PGlite.
DATABASE_URL=

# Official data APIs (free keys from https://api.data.gov/signup/). Use separate keys: limits are per key.
CONGRESS_API_KEY=
FEC_API_KEY=

# Address to district lookup. Without Geocodio, the U.S. Census Bureau geocoder is used (keyless).
GEOCODIO_API_KEY=

# Ask For The People. Without a key, Ask runs on recorded demo responses. In production Ask uses Claude
# only when DATABASE_URL and IP_HASH_SALT are also set (the spend cap and rate limits live in Postgres).
ANTHROPIC_API_KEY=
ASK_MODEL=claude-haiku-4-5-20251001
ASK_MODEL_COMPLEX=claude-sonnet-5
# Salt for hashing IPs in rate limits (a random string of at least 16 characters; required in production).
IP_HASH_SALT=

# Signed cache revalidation from ingestion jobs to the web app (a random secret of at least 32 characters; shorter ones leave it off).
REVALIDATE_URL=
REVALIDATE_SECRET=

# Canonical site URL for share cards and metadata.
NEXT_PUBLIC_SITE_URL=
