# For The People configuration. Copy to .env for local use. Keep real values private.

# Postgres (Neon) for preview and production. Without it, the app loads the bundled snapshot into PGlite.
DATABASE_URL=

# Official data APIs (free keys from https://api.data.gov/signup/). Use separate keys: limits are per key.
CONGRESS_API_KEY=
FEC_API_KEY=

# Address to district lookup. Without Geocodio, the U.S. Census Bureau geocoder is used (keyless).
GEOCODIO_API_KEY=

# Ask For The People and "Ask about this bill" use one model provider, chosen in this order:
#   1. OPENROUTER_API_KEY set: OpenRouter (default models anthropic/claude-sonnet-5 and anthropic/claude-opus-5.5).
#   2. Otherwise ANTHROPIC_API_KEY set: Anthropic directly (default models claude-haiku-4-5-20251001 and claude-sonnet-5).
#   3. Otherwise: recorded demo answers for Ask, and no "Ask about this bill".
# In production a model is used only when DATABASE_URL and IP_HASH_SALT are also set (the spend cap and
# rate limits live in Postgres).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides, in the chosen provider's own ids. An id with no known price uses the default.
ASK_MODEL=
ASK_MODEL_COMPLEX=
# Salt for hashing IPs in rate limits (a random string of at least 16 characters; required in production).
IP_HASH_SALT=
# Set to 1 to use the model in production without DATABASE_URL. The spend cap and rate limits then apply
# per server process, so also set a credit limit on the provider key.
ASK_ALLOW_WITHOUT_DATABASE=

# Signed cache revalidation from ingestion jobs to the web app (a random secret of at least 32 characters; shorter ones leave it off).
REVALIDATE_URL=
REVALIDATE_SECRET=

# Canonical site URL for share cards and metadata.
NEXT_PUBLIC_SITE_URL=
